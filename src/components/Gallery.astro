---
type GalleryItem = {
  title: string;
  category: string;
  image: string;
};

// ============================================================
// 图片上传入口
// ------------------------------------------------------------
// ① 把图片文件放进 public/gallery/  （品牌号笔记建议放 public/gallery/brand-notes/）
// ② 在下面对应的数组里追加一条：
//    { title: '笔记标题', category: '品牌号笔记', image: '/gallery/brand-notes/文件名.png' }
// ③ 保存即可，页面会自动出现这张卡片，不需要改模板
// ============================================================

// 爆款案例：目前已有的 6 张图
const viralCases: GalleryItem[] = [
  { title: '小火车KOL笔记', category: '爆款案例', image: '/gallery/图片1.png' },
  { title: '小火车KOL笔记', category: '爆款案例', image: '/gallery/图片2.png' },
  { title: '小火车KOL笔记', category: '爆款案例', image: '/gallery/图片3.png' },
  { title: '小火车KOL笔记', category: '爆款案例', image: '/gallery/图片4.png' },
  { title: '小火车KOL笔记', category: '爆款案例', image: '/gallery/图片5.png' },
  { title: '小火车KOL笔记', category: '爆款案例', image: '/gallery/图片6.png' },
];

// 品牌号笔记：图片放 public/gallery/brand-notes/，按上面注释的格式追加即可
const brandNotes: GalleryItem[] = [
  { title: '男宝必入 · 6 个益智玩具', category: '品牌号笔记', image: '/gallery/brand-notes/01-nanbao-6-toys.jpg' },
  { title: '宠娃没道理 · 20 品牌宠粉', category: '品牌号笔记', image: '/gallery/brand-notes/02-chongwa-20-brands.jpg' },
  { title: '25 周年 · 超HUI玩大礼包', category: '品牌号笔记', image: '/gallery/brand-notes/03-25anniversary-gift.jpg' },
  { title: '周岁礼必入 · 4合1智趣火车', category: '品牌号笔记', image: '/gallery/brand-notes/04-4in1-smart-train.jpg' },
  { title: '宅家必入 · STEAM 分球叠叠乐', category: '品牌号笔记', image: '/gallery/brand-notes/05-steam-blocks.jpg' },
  { title: '主页笔记合辑 01', category: '品牌号笔记', image: '/gallery/brand-notes/06-profile-grid-01.jpg' },
  { title: '主页笔记合辑 02', category: '品牌号笔记', image: '/gallery/brand-notes/07-profile-grid-02.jpg' },
  { title: '主页笔记合辑 03', category: '品牌号笔记', image: '/gallery/brand-notes/08-profile-grid-03.jpg' },
  { title: '主页笔记合辑 04', category: '品牌号笔记', image: '/gallery/brand-notes/09-profile-grid-04.jpg' },
];

const groups = [
  {
    id: 'viral-cases',
    title: '爆款案例',
    desc: 'KOL 笔记爆文与投放数据成果',
    items: viralCases,
  },
  {
    id: 'brand-notes',
    title: '品牌号笔记',
    desc: '品牌账号自有内容与种草笔记',
    items: brandNotes,
  },
];
---

<section id="gallery" class="container" style="padding-top: 48px;">
  <h2 class="section-title">成果展示</h2>

  {groups.map((group) => (
    <div class="gallery-group" id={group.id}>
      <div class="gallery-group-head">
        <h3 class="gallery-subtitle">{group.title}</h3>
        <span class="gallery-desc">{group.desc}</span>
        {group.items.length > 0 && (
          <span class="gallery-count">{group.items.length} 张</span>
        )}
      </div>

      {group.items.length > 0 ? (
        <div class="gallery-grid">
          {group.items.map((item, index) => (
            <div class="gallery-item" data-group={group.id} data-index={index}>
              <div class="gallery-image-wrapper">
                <img
                  src={item.image}
                  alt={item.title}
                  loading="lazy"
                  class="gallery-image"
                />
                <div class="gallery-overlay">
                  <div class="gallery-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2">
                      <path d="M15 3h6v6" />
                      <polyline points="9 21 3 21 3 15" />
                      <line x1="21" y1="3" x2="14" y2="10" />
                      <line x1="3" y1="21" x2="10" y2="14" />
                    </svg>
                  </div>
                </div>
              </div>
              <div class="gallery-footer">
                <span class="gallery-footer-category">{item.category}</span>
                <span class="gallery-footer-title" title={item.title}>{item.title}</span>
              </div>
            </div>
          ))}
        </div>
      ) : (
        <div class="gallery-empty">
          <div class="gallery-empty-icon">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="3" y="3" width="18" height="18" rx="3" />
              <circle cx="8.5" cy="8.5" r="1.5" />
              <path d="M21 15l-5-5L5 21" />
            </svg>
          </div>
          <p class="gallery-empty-title">品牌号笔记整理中</p>
          <p class="gallery-empty-hint">图片准备好后会自动出现在这里</p>
        </div>
      )}
    </div>
  ))}
</section>

<div id="lightbox" class="lightbox">
    <div class="lightbox-content">
      <button class="lightbox-close" type="button" aria-label="关闭">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18" />
          <line x1="6" y1="6" x2="18" y2="18" />
        </svg>
      </button>
      <button class="lightbox-prev" type="button" aria-label="上一张">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6" />
        </svg>
      </button>
      <button class="lightbox-next" type="button" aria-label="下一张">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="9 18 15 12 9 6" />
        </svg>
      </button>
      <img id="lightbox-image" class="lightbox-image" src="" alt="" />
      <div class="lightbox-caption">
        <span id="lightbox-category"></span>
        <span id="lightbox-title"></span>
      </div>
    </div>
</div>

<style>
  .gallery-group { margin-bottom: 56px; }
  .gallery-group:last-of-type { margin-bottom: 0; }

  .gallery-group-head {
    display: flex;
    align-items: baseline;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
    text-align: center;
  }
  .gallery-subtitle {
    font-size: 1.25rem;
    font-weight: 700;
    margin: 0;
    position: relative;
    padding-left: 14px;
  }
  .gallery-subtitle::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 1em;
    border-radius: 2px;
    background: var(--accent);
  }
  .gallery-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
  .gallery-count {
    font-size: 0.8rem;
    color: var(--accent);
    background: rgba(37, 99, 235, 0.08);
    border-radius: 999px;
    padding: 2px 10px;
  }

  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 360px));
    justify-content: center;
    gap: 24px;
  }
  .gallery-item {
    cursor: pointer;
    border-radius: 12px;
    overflow: hidden;
    background: white;
    box-shadow: var(--card-shadow);
    border: 1px solid var(--border);
    transition: all 0.3s;
  }
  .gallery-item:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1);
    border-color: var(--accent);
  }
  .gallery-image-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    aspect-ratio: 9 / 16;
  }
  .gallery-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #f0f0f0;
    transition: transform 0.3s;
  }
  .gallery-item:hover .gallery-image {
    transform: scale(1.1);
  }
  .gallery-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7), transparent);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 20px;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .gallery-item:hover .gallery-overlay {
    opacity: 1;
  }
  .gallery-icon {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0);
    transition: all 0.3s;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(4px);
    padding: 12px;
    border-radius: 50%;
  }
  .gallery-item:hover .gallery-icon {
    transform: translate(-50%, -50%) scale(1);
  }
  .gallery-footer {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 14px;
    border-top: 1px solid var(--border);
  }
  .gallery-footer-category {
    flex-shrink: 0;
    font-size: 0.7rem;
    color: var(--accent);
    background: rgba(37, 99, 235, 0.08);
    border-radius: 999px;
    padding: 2px 8px;
    white-space: nowrap;
  }
  .gallery-footer-title {
    font-size: 0.85rem;
    color: var(--text-secondary);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .gallery-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 48px 24px;
    border: 1.5px dashed var(--border);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.55);
    text-align: center;
  }
  .gallery-empty-icon { color: var(--border); margin-bottom: 4px; }
  .gallery-empty-title {
    margin: 0;
    font-weight: 600;
    color: var(--text-secondary);
  }
  .gallery-empty-hint {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-secondary);
    opacity: 0.7;
  }

  .lightbox {
    display: none;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.9);
    z-index: 200;
    justify-content: center;
    align-items: center;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .lightbox.active {
    display: flex;
    opacity: 1;
  }
  .lightbox-content {
    position: relative;
    max-width: 90%;
    max-height: 90%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .lightbox-image {
    max-width: 100%;
    max-height: 80vh;
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
  }
  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: rgba(255, 255, 255, 0.1);
    border: none;
    border-radius: 50%;
    color: white;
    padding: 12px;
    cursor: pointer;
    transition: background 0.2s;
  }
  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    background: rgba(255, 255, 255, 0.3);
  }
  .lightbox-close {
    top: -40px;
    right: 0;
  }
  .lightbox-prev {
    left: -50px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-next {
    right: -50px;
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox-caption {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    color: white;
  }
  #lightbox-category {
    padding: 4px 12px;
    background: var(--accent);
    border-radius: 999px;
    font-size: 0.85rem;
  }
  #lightbox-title {
    font-size: 1.1rem;
    font-weight: 500;
  }
  @media (max-width: 768px) {
    .gallery-group { margin-bottom: 40px; }
    .gallery-grid {
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    }
    .gallery-empty { padding: 32px 20px; }
    .lightbox-content {
      max-width: 95%;
      max-height: 100%;
    }
    .lightbox-image {
      max-width: 100%;
      max-height: 50vh;
    }
    .lightbox-caption {
      margin-top: 10px;
      gap: 4px;
    }
    .lightbox-close,
    .lightbox-prev,
    .lightbox-next {
      padding: 8px;
    }
    .lightbox-prev {
      left: 10px;
    }
    .lightbox-next {
      right: 10px;
    }
    .lightbox-close {
      right: 10px;
    }
  }
</style>

<script is:inline define:vars={{ galleryGroups: groups.map((g) => ({ id: g.id, items: g.items })) }}>
  // 灯箱：只在同一分组内前后切换
  const groupsData = galleryGroups || [];
  let activeGroupItems = [];
  let activePos = 0;

  function openLightbox(groupId, index) {
    const group = groupsData.find((g) => g.id === groupId);
    if (!group || !group.items.length) return;
    activeGroupItems = group.items;
    activePos = index;
    updateLightbox();
    document.getElementById('lightbox').classList.add('active');
    document.body.style.overflow = 'hidden';
  }

  function closeLightbox() {
    document.getElementById('lightbox').classList.remove('active');
    document.body.style.overflow = '';
  }

  function updateLightbox() {
    const item = activeGroupItems[activePos];
    if (!item) return;
    document.getElementById('lightbox-image').src = item.image;
    document.getElementById('lightbox-image').alt = item.title;
    document.getElementById('lightbox-category').textContent = item.category;
    document.getElementById('lightbox-title').textContent = item.title;
    const single = activeGroupItems.length <= 1;
    document.querySelectorAll('.lightbox-prev, .lightbox-next').forEach((btn) => {
      btn.style.display = single ? 'none' : '';
    });
  }

  function prevImage() {
    if (activeGroupItems.length < 2) return;
    activePos = (activePos - 1 + activeGroupItems.length) % activeGroupItems.length;
    updateLightbox();
  }

  function nextImage() {
    if (activeGroupItems.length < 2) return;
    activePos = (activePos + 1) % activeGroupItems.length;
    updateLightbox();
  }

  document.addEventListener('click', function (e) {
    const item = e.target.closest('.gallery-item');
    if (item) {
      openLightbox(item.dataset.group, parseInt(item.dataset.index, 10));
    }
  });

  // 绑定灯箱交互（不用内联 onclick，避免脚本被包进 IIFE 后函数不可见）
  const lightboxEl = document.getElementById('lightbox');
  const lightboxContent = lightboxEl.querySelector('.lightbox-content');
  lightboxEl.addEventListener('click', closeLightbox);
  lightboxContent.addEventListener('click', function (e) { e.stopPropagation(); });
  lightboxContent.querySelector('.lightbox-close').addEventListener('click', closeLightbox);
  lightboxContent.querySelector('.lightbox-prev').addEventListener('click', prevImage);
  lightboxContent.querySelector('.lightbox-next').addEventListener('click', nextImage);

  document.addEventListener('keydown', function (e) {
    if (document.getElementById('lightbox').classList.contains('active')) {
      if (e.key === 'Escape') closeLightbox();
      if (e.key === 'ArrowLeft') prevImage();
      if (e.key === 'ArrowRight') nextImage();
    }
  });
</script>
